[Unit]
Description=Galactic Bridge preview server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GalacticBridge
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=STATIC_ROOT=%h/GalacticBridge
ExecStart=/usr/bin/python3 %h/GalacticBridge/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
